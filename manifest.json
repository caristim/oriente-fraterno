const SW_VERSION = 'of-sw-v12';
const CACHE_NAME = 'of-cache-v12';
const DB_NAME = 'of_sw';
const DB_VERSION = 1;
const APP_URL = 'https://caristim.github.io/oriente-fraterno/';

